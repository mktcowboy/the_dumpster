: [{"slug": "fortune500", "title": "Fortune 500", "year": 2026, "rank": 425, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2025, "rank": 405, "itemDescription": ""}, {"slug": "fortune500--apparel", "title": "Fortune Sector Leaders: Apparel", "year": 2024, "rank": 2, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2024, "rank": 355, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2026, "rank": 425, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2025, "rank": 405, "itemDescription": ""}, {"slug": "fortune500--apparel", "title": "Fortune Sector Leaders: Apparel", "year": 2024, "rank": 2, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2024, "rank": 355, "itemDescription": ""}, {"slug": "worlds-most-admired-companies", "title": "World's Most Admired Companies", "year": 2023, "rank": null, "itemDescription": ""}, {"slug": "change-the-world", "title": "Change the World", "year": 2023, "rank": 50, "itemDescription": "VF Corporation, the owner of Timberland, Vans, and The North Face, has created the world's first regenerative rubber supply chain\u2014the Regenerative Rubber Alliance. In partnership with design firm Terra Genesis and farmer communities in Thailand, the initiative transforms monoculture rubber farms into more diverse, resilient, and productive gardens. RRA gardens are sequestering more carbon, improving soil health, and increasing biodiversity in comparison to the rubber plantations that dominate the industry. Farmers also benefit from increased yields, reduced reliance on chemicals, and higher incomes. The project has already engaged over 300 farmers across 500 rubber plots, covering more than 1,660 acres, and aims to reach 30,000 farmers by 2030."}, {"slug": "fortune500", "title": "Fortune 500", "year": 2023, "rank": 349, "itemDescription": ""}, {"slug": "worlds-most-admired-companies", "title": "World's Most Admired Companies", "year": 2022, "rank": null, "itemDescription": ""}, {"slug": "change-the-world", "title": "Change the World", "year": 2022, "rank": 38, "itemDescription": "\u201cTraceability maps\u201d are catching on in the apparel industry, as more customers and governments seek evidence that brands are sustainable and aren\u2019t using forced labor. VF, parent of several big brands, goes far deeper than its peers. Customers can find, for example, pictures of the Chinese chemical factory that makes rubber for Vans shoes, or the Vietnamese mill that spins cotton into North\u00a0Face jackets. This year, VF reached its goal of publishing maps for 100 top-selling products; competitors are taking note."}, {"slug": "fortune500", "title": "Fortune 500", "year": 2022, "rank": 380, "itemDescription": ""}, {"slug": "worlds-most-admired-companies", "title": "World's Most Admired Companies", "year": 2021, "rank": null, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2021, "rank": 263, "itemDescription": "The worldwide apparel and footwear company has its largest stake in the backpack market, with popular brands such as JanSport, North Face, and Timberland. In November 2020, VF announced it was buying Supreme, an incredibly popular brand associated with youth culture, for more than $2 billion."}, {"slug": "worlds-most-admired-companies", "title": "World's Most Admired Companies", "year": 2020, "rank": null, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2020, "rank": 233, "itemDescription": "The clothing company owns brands including JanSport, The North Face, Smartwool, Timberland, Eastpak, Vans, and others."}, {"slug": "worlds-most-admired-companies", "title": "World's Most Admired Companies", "year": 2019, "rank": null, "itemDescription": ""}, {"slug": "fortune500", "title": "Fortune 500", "year": 2019, "rank": 252, "itemDescription": ""}, {"slug": "worlds-most-admired-companies", "title": "World's Mo