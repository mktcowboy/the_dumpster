{"companyInfo": {"Updated": "6/3/26", "Footnote": "Includes revenues from discontinued operations. Figures are for fiscal year ended March 31, 2025. Market value as of March 31, 2026.", "Country/Territory": "U.S.", "Headquarters": "Denver, Colo.", "Industry": "Apparel", "CEO": "Bracken P. Darrell", "Website": "https://www.vfc.com", "Ticker": "VFC", "Company type": "Public", "Revenues ($M)": "$9,749", "Profits ($M)": "$-190", "Market value ($M)": "$6,648", "Number of employees": "21,600", "StockQuote": "NYSE"}, "description": "VF designs and sells branded lifestyle apparel, footwear, and accessories for men, women, and children. It operates through three segments: outdoor, active, and work. Its outdoor brands include the North Face, Timberland, and Smartwool. It also offers sports-inspired and streetwear brands including Vans, Kipling, Eastpak, and JanSport, and \u201cwork and work-inspired\u201d apparel and footwear under the Dickies and Timberland PRO brands. It reached an agreement to sell the Supreme streetwear brand to EssilorLuxottica in July 2024.", "dataTables": [{"changeHeader": "", "footnote": "", "title": "World's Most Admired Companies", "valueHeader": "", "values": [{"change": null, "title": "Sector", "value": "Consumer Products"}, {"change": null, "title": "Industry", "value": "Apparel"}, {"change": null, "title": "Industry Rank", "value": "5"}, {"change": null, "title": "Previous Industry Rank", "value": "3"}, {"change": null, "title": "Overall Score", "value": "6.34"}, {"change": null, "title": "Innovation", "value": "7"}, {"change": null, "title": "People Management", "value": "7"}, {"change": null, "title": "Use of Corporate Assets", "value": "5"}, {"change": null, "title": "Social Responsibility", "value": "2"}, {"change": null, "title": "Quality of Management", "value": "5"}, {"change": null, "title": "Financial Soundness", "value": "6"}, {"change": null, "title": "Long-Term Investment Value", "value": "4"}, {"change": null, "title": "Quality of P