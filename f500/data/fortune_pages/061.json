{"companyInfo": {"Updated": "7/28/26", "Footnote": "Market value as of July 13, 2026.", "Country/Territory": "U.S.", "Headquarters": "Bethesda, Md.", "Industry": "Aerospace & Defense", "CEO": "James D. Taiclet", "Website": "https://www.lockheedmartin.com", "Ticker": "LMT", "Company type": "Public", "Revenues ($M)": "$75,048", "Profits ($M)": "$5,017", "Market value ($M)": "$120,050", "Number of employees": "123,000", "StockQuote": "NYSE"}, "description": "Lockheed Martin is a global aerospace and security company involved in the research, design, and production of everything from jet fighters and missile defense systems to satellites and spacecraft. Lockheed Martin does the majority of its business with the U.S. Department of Defense and other federal agencies. Its roots go back to the early 20th century as an aircraft industry pioneer that became an important partner to the U.S. military during World War II. The modern company was formed in 1995 when Lockheed Corp. merged with Martin Marietta Corp., another large defense contractor.", "dataTables": [{"changeHeader": "", "footnote": "", "title": "World's Most Admired Companies", "valueHeader": "", "values": [{"change": null, "title": "Sector", "value": "Transport"}, {"change": null, "title": "Industry", "value": "Aerospace and Defense"}, {"change": null, "title": "Current All-Star Rank", "value": "47"}, {"change": null, "title": "Previous All-Star Rank", "value": "-"}, {"change": null, "title": "Industry Rank", "value": "3"}, {"change": null, "title": "Previous Industry Rank", "value": "1"}, {"change": null, "title": "Overall Score", "value": "7.18"}, {"change": null, "title": "Innovation", "value": "7"}, {"change": null, "title": "People Management", "value": "2"}, {"change": null, "title": "Use of Corporate Assets", "value": "3"}, {"change": null, "title": "Social Responsibility", "value": "3"}, {"change": null, "title": "Quality of Management", "value": "5"}, {"change": null, "title": "Financial Soundness", "valu