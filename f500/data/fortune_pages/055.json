{"companyInfo": {"Updated": "7/28/26", "Footnote": "Figures are for fiscal year ended June 30, 2025. Market value as of July 13, 2026.", "Country/Territory": "U.S.", "Headquarters": "Houston", "Industry": "Wholesalers: Food and Grocery", "CEO": "Kevin P. Hourican", "Website": "https://www.sysco.com", "Ticker": "SYY", "Company type": "Public", "Revenues ($M)": "$81,370", "Profits ($M)": "$1,828", "Market value ($M)": "$39,909", "Number of employees": "75,000", "StockQuote": "NYSE"}, "description": "Sysco is a marketer and distributor of food and related products to the food service or food-away-from-home industries in the U.S., Canada, the U.K., France, and elsewhere. The company serves restaurants, hospitals and nursing facilities, schools and colleges, hotels and motels, industrial caterers, and other food service venues. Sysco was incorporated in 1969 and is headquartered in Houston.", "dataTables": [{"changeHeader": "", "footnote": "", "title": "America's Most Innovative Companies", "valueHeader": "", "values": [{"change": null, "title": "Sector", "value": "Wholesalers"}, {"change": null, "title": "Strongest Dimension", "value": "Process innovation"}, {"change": null, "title": "Years on list", "value": "2"}, {"change": null, "title": "Previous rank", "value": "227"}, {"change": null, "title": "State", "value": "Texas"}]}, {"changeHeader": "% change", "footnote": "", "title": "Key Financials (last Fiscal Year)", "valueHeader": "($ Millions)", "values": [{"change": "3.2%", "title": "Revenues ($M)", "value": "$81,370"}, {"change": "-6.5%", "title": "Profits ($M)", "value": "$1,828"}, {"change": "-", "title": "Assets ($M)", "value": "$26,774"}, {"change": "-", "title": "Total Stockholder Equity ($M)", "value": "$1,830"}]}, {"changeHeader": "", "footnote": "", "title": "Profit Ratios", "valueHeader": "", "values": [{"change": null, "title": "Profit as % of Revenues", "value": "2.3%"}, {"change": null, "title": "Profits as % of Assets", "value": "6.8%"}, {"change": nul