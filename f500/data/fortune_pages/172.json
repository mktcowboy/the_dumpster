{"companyInfo": {"Updated": "6/3/26", "Footnote": "Market value as of March 31, 2026.", "Country/Territory": "U.S.", "Headquarters": "New York City", "Industry": "Insurance: Property and Casualty (Stock)", "CEO": "Eric Andersen", "Website": "https://www.aig.com", "Ticker": "AIG", "Company type": "Public", "Revenues ($M)": "$26,775", "Profits ($M)": "$3,096", "Market value ($M)": "$40,376", "Number of employees": "22,100", "StockQuote": "NYSE"}, "description": "AIG is a global property-casualty insurer dating back to 1919. It sells insurance products to individuals and businesses in over 200 countries and jurisdictions, reached through its own operations, licenses and authorizations, and network partners. Former AIG subsidiary SAFG Retirement Services rebranded to Corebridge Financial when it went public in 2022. (In 2026, Corebridge agreed to merge with Equitable Holdings.)", "dataTables": [{"changeHeader": "", "footnote": "", "title": "Nine Key Attributes Of Reputation", "valueHeader": "Rank", "values": [{"change": null, "title": "Innovation", "value": "3"}, {"change": null, "title": "People Management", "value": "7"}, {"change": null, "title": "Use of Corporate Assets", "value": "12"}, {"change": null, "title": "Social Responsibility", "value": "15"}, {"change": null, "title": "Quality of Management", "value": "7"}, {"change": null, "title": "Financial Soundness", "value": "11"}, {"change": null, "title": "Long-Term Investment Value", "value": "6"}, {"change": null, "title": "Quality of products / services", "value": "5"}, {"change": null, "title": "Global Competitiveness", "value": "1"}]}, {"changeHeader": "% change", "footnote": "", "title": "Key Financials (last Fiscal Year)", "valueHeader": "$ millions", "values": [{"change": "-1.8%", "title": "Revenues ($M)", "value": "$26,775"}, {"change": "-", "title": "Profits ($M)", "value": "$3,096"}, {"change": "-", "title": "Assets ($M)", "value": "$161,254"}, {"change": "-", "title": "Total Stockholder Equity ($M)", "