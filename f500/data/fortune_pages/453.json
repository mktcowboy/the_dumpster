{"companyInfo": {"Updated": "6/3/26", "Footnote": "Market value as of March 31, 2026.", "Country/Territory": "U.S.", "Headquarters": "Kingsport, Tenn.", "Industry": "Chemicals", "CEO": "Mark J. Costa", "Website": "https://www.eastman.com", "Ticker": "EMN", "Company type": "Public", "Revenues ($M)": "$8,752", "Profits ($M)": "$474", "Market value ($M)": "$8,727", "Number of employees": "13,000", "StockQuote": "NYSE"}, "description": "Eastman Chemical is a global specialty materials business that produces advanced materials, chemicals, and fibers. The company was founded in 1920 by inventor and high school dropout George Eastman, most known for his revolutionary innovation of the Kodak camera. Eastman Chemical Company was launched in order to provide Kodak\u2019s business with raw materials such as photographic paper, optical glass, gelatin, and chemicals after a scarcity following World War I. Today, Eastman Chemical serves clients in a range of industries including agriculture, construction, water treatment, energy, wellness, electronics, and more.", "dataTables": [{"changeHeader": "", "footnote": "", "title": "Change The World", "valueHeader": "", "values": [{"change": null, "title": "Impact Segment", "value": "Environmental Impact"}, {"change": null, "title": "Sector", "value": "Industrials"}]}, {"changeHeader": "% change", "footnote": "", "title": "Key Financials (last Fiscal Year)", "valueHeader": "$ millions", "values": [{"change": "-6.7%", "title": "Revenues ($M)", "value": "$8,752"}, {"change": "-47.6%", "title": "Profits ($M)", "value": "$474"}, {"change": "-", "title": "Assets ($M)", "value": "$14,859"}, {"change": "-", "title": "Total Stockholder Equity ($M)", "value": "$5,961"}]}, {"changeHeader": "", "footnote": "", "title": "Profit Ratios", "valueHeader": "", "values": [{"change": null, "title": "Profit as % of Revenues", "value": "5.4%"}, {"change": null, "title": "Profits as % of Assets", "value": "3.2%"}, {"change": null, "title": "Profits as % of St