<script>
(function(){
  var d=document,root=d.documentElement,hdr=d.querySelector('.hdr'),MENUS=['docs','resources','tools'];
  function menu(k){return d.getElementById('hm-'+k)}
  function trigger(k){return hdr.querySelector('.hdr-link[data-k="'+k+'"]')}

  // Active item: <body data-nav="..."> names the page. The blog and the company pages sit under Resources.
  var nk=d.body.getAttribute('data-nav'),UNDER={blog:'resources',about:'resources',licensing:'resources',privacy:'resources',terms:'resources'},cur=UNDER[nk]||nk;
  if(cur)hdr.querySelectorAll('.hdr-link[data-k="'+cur+'"],.m-row[data-k="'+cur+'"]').forEach(function(el){el.setAttribute('aria-current',el.tagName==='A'?'page':'true')});
  hdr.querySelectorAll('.hdr-item').forEach(function(a){if(a.getAttribute('href')===location.pathname)a.setAttribute('aria-current','page')});

  // Desktop menus. Hovering a trigger opens its menu; the pill follows the pointer; switching menus slides the panel
  // in nav order and resizes it. Leaving the bar closes after a short grace, so a diagonal move into the panel survives.
  var nav=hdr.querySelector('.hdr-nav'),bar=hdr.querySelector('.hdr-bar'),pill=hdr.querySelector('.hdr-pill');
  var open=null,last=null,hover=null,timer=0,ptr='';
  function paint(){
    var shown=open||last,pk=hover||open;
    hdr.toggleAttribute('data-open',!!open);
    MENUS.forEach(function(k,i){
      menu(k).inert=open!==k;
      menu(k).setAttribute('data-pos',k===shown?'on':i<MENUS.indexOf(shown)?'l':'r');
      trigger(k).setAttribute('aria-expanded',String(open===k));
    });
    if(shown)nav.style.setProperty('--ph',menu(shown).firstElementChild.offsetHeight+2+'px');
    pill.classList.toggle('on',!!pk);
    // Layout offsets match the pill's CSS coordinates, including when the page is zoomed.
    if(pk){var it=trigger(pk);pill.style.left=it.offsetLeft+'px';pill.style.width=it.offsetWidth+'px'}
  }
  // From closed the panel only fades in: no slide and no height change.
  function openMenu(k){
    clearTimeout(timer);
    if(!open){hdr.setAttribute('data-instant','');requestAnimationFrame(function(){requestAnimationFrame(function(){hdr.removeAttribute('data-instant')})})}
    open=last=k;paint();
  }
  function closeNow(){clearTimeout(timer);open=hover=null;pill.classList.remove('slide');paint()}
  // Hover is for a mouse only: a tap at desktop width would otherwise open on enter and close again on click.
  function mouse(e){return e.pointerType==='mouse'}
  hdr.querySelectorAll('.hdr-links>li').forEach(function(li){
    var it=li.firstElementChild,k=it.getAttribute('data-k'),isMenu=it.tagName==='BUTTON';
    li.addEventListener('pointerenter',function(e){
      if(!mouse(e))return;
      pill.classList.toggle('slide',!!(hover||open));
      hover=k;
      if(isMenu)openMenu(k);else{clearTimeout(timer);open=null;paint()}
    });
    if(!isMenu)return;
    // A mouse is over the trigger when it clicks, so its menu is already open from the hover and the click keeps it
    // open. Keyboard (Enter, Space) and touch still toggle it.
    it.addEventListener('pointerdown',function(e){ptr=e.pointerType});
    it.addEventListener('click',function(e){
      var byMouse=e.detail>0&&ptr==='mouse';ptr='';
      if(open===k&&byMouse&&hover===k)return;
      if(open===k)closeNow();else openMenu(k);
    });
  });
  bar.addEventListener('pointerenter',function(e){if(mouse(e))clearTimeout(timer)});
  bar.addEventListener('pointerleave',function(e){if(!mouse(e))return;hover=null;paint();clearTimeout(timer);timer=setTimeout(closeNow,140)});
  hdr.querySelector('.hdr-dim').addEventListener('click',closeNow);
  hdr.querySelector('.hdr-links').addEventListener('click',function(e){if(e.target.closest('.hdr-item'))closeNow()});
  // Keyboard: Tab past the open menu's last link (or out of the header) closes it.
  nav.addEventListener('focusout',function(e){if(open&&e.relatedTarget&&!menu(open).parentNode.contains(e.relatedTarget))closeNow()});
  addEventListener('resize',function(){if(open||hover)paint()});

  // Phone menu sheet: a root list that drills into each section, with a Back button.
  var sheet=d.getElementById('m-sheet'),btn=hdr.querySelector('.menu-btn'),close=sheet.querySelector('.m-close'),back=sheet.querySelector('.m-back'),logo=sheet.querySelector('.m-top a'),mroot=sheet.querySelector('.m-root'),sub=null;
  MENUS.forEach(function(k){d.getElementById('ms-'+k).appendChild(menu(k).firstElementChild.cloneNode(true))});
  function drill(k){
    sub=k;sheet.classList.toggle('m-deep',!!k);mroot.inert=!!k;logo.hidden=!!k;back.hidden=!k;
    MENUS.forEach(function(x){var s=d.getElementById('ms-'+x);s.classList.toggle('m-on',x===k);s.inert=x!==k});
  }
  drill(null);
  function setOpen(on,refocus){
    if(!on)drill(null);
    sheet.hidden=!on;
    root.style.overflow=on?'hidden':'';
    btn.setAttribute('aria-expanded',String(on));
    btn.setAttribute('aria-label',on?'Close menu':'Open menu');
    if(on)close.focus();else if(refocus)btn.focus();
  }
  btn.addEventListener('click',function(){setOpen(sheet.hidden)});
  close.addEventListener('click',function(){setOpen(false,true)});
  mroot.addEventListener('click',function(e){var b=e.target.closest('button[data-k]');if(b){drill(b.getAttribute('data-k'));back.focus()}});
  back.addEventListener('click',function(){var k=sub;drill(null);mroot.querySelector('[data-k="'+k+'"]').focus()});
  sheet.addEventListener('click',function(e){if(e.target.closest('a'))setOpen(false)});
  // While the sheet is open, Tab and Shift-Tab cycle through its visible controls only.
  function trap(e){
    var f=[].filter.call(sheet.querySelectorAll('a[href],button:not([disabled])'),function(el){return el.getClientRects().length>0&&!el.closest('[inert]')});
    if(!f.length)return;
    var first=f[0],last=f[f.length-1],a=d.activeElement,out=!sheet.contains(a);
    if(e.shiftKey&&(a===first||out)){e.preventDefault();last.focus()}
    else if(!e.shiftKey&&(a===last||out)){e.preventDefault();first.focus()}
  }
  d.addEventListener('keydown',function(e){
    if(!sheet.hidden){if(e.key==='Escape')setOpen(false,true);else if(e.key==='Tab')trap(e);return}
    if(e.key==='Escape'&&open){var li=menu(open).parentNode,inside=li.contains(d.activeElement);closeNow();if(inside)li.firstElementChild.focus()}
  });
  var wide=matchMedia('(min-width:960px)');
  wide.addEventListener('change',function(){if(!wide.matches)closeNow();else if(!sheet.hidden)setOpen(false)});

  // Auth state: Sign in / Get started <-> Dashboard / Sign out, on every host (localhost included).
  function setAuth(on){if(on)root.setAttribute('data-auth','in');else root.removeAttribute('data-auth')}
  function loadSupabase(){
    if(window.supabase)return Promise.resolve(window.supabase);
    if(!window.__xflSbLoading)window.__xflSbLoading=new Promise(function(res,rej){
      var s=d.createElement('script');s.src='https://unpkg.com/@supabase/supabase-js@2.104.0';s.async=true;
      s.onload=function(){res(window.supabase)};s.onerror=rej;d.head.appendChild(s);
    });
    return window.__xflSbLoading;
  }
  var sb=null;
  loadSupabase().then(function(lib){
    if(!window.__xflSb)window.__xflSb=lib.createClient('https://auth.xfinlink.com','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0bnFnZWF4ZHN6c3JmYmJtbHZjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY0MjUyMjUsImV4cCI6MjA5MjAwMTIyNX0.y98sbeOC0dMyZ8UYLdE-7_imMorEy1G8S8PV_UgsqD4');
    sb=window.__xflSb;
    sb.auth.getSession().then(function(r){
      var s=r&&r.data&&r.data.session;setAuth(!!s);
      // Attach the session recording to the real account, once per load (production host only).
      if(s&&window.posthog&&window.__xflProd)posthog.identify(s.user.id,{email:s.user.email});
    }).catch(function(){});
    // No session (signed out here, on the dashboard or in another tab): drop the plan Pricing keeps (pricing.js).
    sb.auth.onAuthStateChange(function(_e,session){setAuth(!!session);if(!session)try{localStorage.removeItem('xfl_plan')}catch(e){}});
  }).catch(function(){});
  d.querySelectorAll('.hdr [data-signout]').forEach(function(b){
    b.addEventListener('click',function(){
      if(!sb){setAuth(false);return}
      sb.auth.signOut().then(function(){location.reload()});
    });
  });
})();
</script>

<main id="main">

<section class="lk-sec">
