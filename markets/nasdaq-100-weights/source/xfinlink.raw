            <button type="button" class="lk-btn lk-out" id="lk-copy" aria-haspopup="dialog" aria-expanded="false"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M9.5 2.5V2A1.5 1.5 0 0 0 8 .5H2A1.5 1.5 0 0 0 .5 2v6A1.5 1.5 0 0 0 2 9.5h.5" stroke="currentColor" stroke-width="1.4"/></svg><span>Copy</span></button>
            <button type="button" class="lk-btn lk-out" id="lk-csv" aria-haspopup="dialog" aria-expanded="false"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v8M3.5 5.5 7 9l3.5-3.5M1.5 12.5h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Download CSV</button>
            <div class="lk-xp" id="lk-xp" role="dialog" aria-labelledby="lk-xp-t" hidden>
