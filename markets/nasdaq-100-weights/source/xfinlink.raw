                  <div role="columnheader" aria-sort="none"><button type="button" class="lk-sort" data-sort="ticker">Ticker<svg width="8" height="11" viewBox="0 0 8 11" aria-hidden="true"><path d="M4 1 7 4.5H1z" fill="currentColor"/><path d="M4 10 1 6.5h6z" fill="currentColor"/></svg></button></div>
                  <div role="columnheader" aria-sort="none"><button type="button" class="lk-sort" data-sort="joined">Joined<svg width="8" height="11" viewBox="0 0 8 11" aria-hidden="true"><path d="M4 1 7 4.5H1z" fill="currentColor"/><path d="M4 10 1 6.5h6z" fill="currentColor"/></svg></button></div>
                  <div role="columnheader" aria-sort="none" data-pop="status"><button type="button" class="lk-sort" data-sort="status">Status today<svg width="8" height="11" viewBox="0 0 8 11" aria-hidden="true"><path d="M4 1 7 4.5H1z" fill="currentColor"/><path d="M4 10 1 6.5h6z" fill="currentColor"/></svg></button><button type="button" class="lk-filter" id="lk-filter" aria-label="Filter by status today" aria-expanded="false" aria-haspopup="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.5 2h9L7 6.2V10L5 9V6.2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg><span id="lk-fn"></span></button>
