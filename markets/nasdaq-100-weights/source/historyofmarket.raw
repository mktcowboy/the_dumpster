<style>
  @font-face{font-family:"Literata HOM";src:url("/fonts/Literata-Book.woff2") format("woff2");font-weight:400;font-style:normal;font-display:swap}
  @font-face{font-family:"Literata HOM";src:url("/fonts/Literata-Semi.woff2") format("woff2");font-weight:600;font-style:normal;font-display:swap}
  @font-face{font-family:"Literata HOM";src:url("/fonts/Literata-BookItalic.woff2") format("woff2");font-weight:400;font-style:italic;font-display:swap}
  @font-face{font-family:"Apparatus HOM";src:url("/fonts/MerriweatherSans-Med.woff2") format("woff2");font-weight:500;font-style:normal;font-display:swap}
  @font-face{font-family:"Apparatus HOM";src:url("/fonts/MerriweatherSans-Bold.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:"HOM Figure";src:url("/fonts/HOMFigure-Med.woff2") format("woff2");font-weight:500;font-style:normal;font-display:swap}
  @font-face{font-family:"HOM Figure";src:url("/fonts/HOMFigure-Bold.woff2") format("woff2");font-weight:700;font-style:normal;font-display:swap}
  @font-face{font-family:"HOM Nameplate Sm";src:url("/fonts/HOMNameplate-Sm.woff2") format("woff2");font-weight:900;font-style:normal;font-display:block}
  :root {
  --fs-folio:10px; --fs-micro:12px; --fs-caption:13.5px; --fs-body:16px; --fs-lead:19px; --fs-h3:24px; --fs-h2:clamp(26px, 3.4vw, 34px); --fs-h1:clamp(34px, 5.2vw, 52px); --fs-opener:clamp(44px, 5.8vw, 80px); --track-display:-0.022em; --track-mid:-0.012em;
  --paper: #FFFFFF; --paper-tint: #F0F4F1; --paper-deep: #E6EBE8; --ink: #181822; --ink-soft: #41414B; --ink-mute: #5C5C65; --ink-faint: #6E6F78; --hairline: #B4BDBC; --hairline-strong: #6C7579; --signal: #1F3656; --gold: #97570D; --verdant: #006967; --oxblood: #A0292A;
    /* Read by the live chart's stylesheet; lifted from the built app bundle
     * so there is only ever one definition. See panelTokenBlock(). */
    --accent-rail: var(--brand-gold);
    --brand-font-display: var(--brand-font-sans);
    --brand-font-editorial: var(--brand-font-sans);
    --brand-font-figure: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    --brand-font-italic: var(--brand-font-sans);
    --brand-font-mono: var(--brand-font-figure);
    --brand-font-sans: var(--latin-body), "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", "Noto Sans SC", "Heiti SC", system-ui, sans-serif;
    --brand-font-serif: var(--brand-font-sans);
    --chart-height: 360px;
    --dist-col-pad: 4px;
    --dist-gain: var(--verdant);
    --dist-loss: var(--oxblood);
    --dist-tile-gap: 4px;
    --dist-tile-h: 30px;
    --ease-standard: var(--motion-ease-out,cubic-bezier(.22, 1, .36, 1));
    --hairline-ghost: #18182214;
    --motion-base: .24s;
    --motion-ease-out: cubic-bezier(.22, 1, .36, 1);
    --motion-enter: .32s;
    --motion-fast: var(--motion-quick,.14s);
    --motion-mid: var(--motion-base,.24s);
    --motion-quick: .14s;
    --page-measure: 1780px;
    --panel-gap: 24px;
    --radius-lg: .5rem;
    --radius-md: .375rem;
    --radius-sm: .25rem;
    --shadow-soft: 0 20px 48px oklab(0% none none/.1);
    --signal-wash: #1f36561a;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { background: var(--paper); color: var(--ink); font-family: "Literata HOM", "PingFang SC", "Microsoft YaHei", Georgia, serif; font-optical-sizing: none; font-synthesis: none; line-height: 1.56; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  main { max-width: 820px; margin: 0 auto; padding: 32px 28px 96px; }
  .site-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 20px; align-items: start; margin: 0 0 30px; }
  .site-mark { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 9px; justify-self: start; min-width: 0; color: var(--ink); text-decoration: none; }
  .site-mark-name { font-family: "HOM Nameplate Sm", Georgia, serif; font-weight: 900; font-size: var(--fs-h2); line-height: 0.92; letter-spacing: var(--track-display); font-optical-sizing: none; font-variant-ligatures: common-ligatures; font-synthesis: none; white-space: nowrap; }
  .site-mark-name--cjk { letter-spacing: 0.08em; line-height: 1; }
  .brand-tally { display: block; line-height: 0; color: var(--ink); }
  .brand-tally svg { display: block; }
  .site-find { display: inline-flex; align-items: center; gap: 7px; margin-top: 2px; padding: 7px 12px; border: 1px solid var(--hairline-strong); color: var(--ink); text-decoration: none; font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-folio); letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .site-find svg { flex: none; }
  .site-vols { grid-column: 1 / -1; display: flex; gap: 20px; margin-top: 16px; padding: 9px 0 8px; border-top: 1px solid var(--hairline); border-bottom: 3px double var(--ink); overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  .site-vols::-webkit-scrollbar { display: none; }
  .site-vols a { flex: 0 0 auto; padding: 3px 0; font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-folio); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-mute); text-decoration: none; }
  .site-vols a[aria-current] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (hover: hover) { .site-find:hover { border-color: var(--ink); } .site-vols a:hover { color: var(--gold); } }
  @media (min-width: 641px) { .site-vols { flex-wrap: wrap; row-gap: 4px; overflow-x: visible; } }
  @media (max-width: 640px) { .site-find { padding: 8px; } .site-find-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; } .site-vols { gap: 16px; } }
  .crumbs, .tag, .cta, .link-raw, .colophon, dt, small { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .crumbs { font-size: var(--fs-folio); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 18px; }
  a { color: var(--signal); text-underline-offset: 3px; }
  .folio { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-folio); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px; }
  .running-head { font-variant-numeric: tabular-nums; }
  .pager { display: flex; gap: 20px; margin-top: 64px; padding-top: 18px; border-top: 1px solid var(--hairline); }
  .pager a { flex: 1 1 0; min-width: 0; display: block; text-decoration: none; color: var(--ink); padding: 4px 0; }
  .pager-next { text-align: right; }
  .pager-end { flex: 1 1 0; }
  .pager-dir { display: block; font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-size: var(--fs-folio); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 3px; }
  .pager-prev .pager-dir::before { content: "\2039\00a0"; }
  .pager-next .pager-dir::after { content: "\00a0\203a"; }
  .pager-title { display: block; font-size: var(--fs-body); line-height: 1.35; }
  @media (hover: hover) { .pager a:hover .pager-title { color: var(--gold); } }
  @media (max-width: 640px) { .pager { flex-direction: column; gap: 14px; } .pager-next { text-align: left; } .pager-end { display: none; } }
  .tag { display: inline-block; font-size: var(--fs-folio); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); padding: 4px 10px; border: 1px solid var(--hairline); background: var(--paper-tint); margin-bottom: 24px; }
  /* overflow-wrap because German. "Halbleiterindustrie",
     "Marktkapitalisierung", "Durchschnittsrendite" — a single compound noun in
     a heading is routinely wider than a 343px column, and a word that cannot
     break takes the whole document sideways with it: /de/xlk/xlk-price/ ran an
     h1 to 455px inside its 343px box and eleven German panel pages scrolled at
     375px. The articles were given this fix; the panel pages, generated by a
     different script, never were. break-word and not anywhere, for the reason
     the articles' rule states: anywhere also shrinks min-content width, which
     moves fixed-width layout elsewhere on the page.
     (No backticks in this comment: it lives inside a JS template literal, and
     one would end the string mid-stylesheet. AGENTS.md records this trap; it
     caught me anyway.) */
  h1 { font-weight: 700; font-size: var(--fs-h1); line-height: 1.14; margin: 0 0 12px; letter-spacing: 0; text-wrap: balance; overflow-wrap: break-word; }
  h2 { font-size: var(--fs-body); margin: 0 0 14px; color: var(--signal); font-style: italic; font-weight: 500; }
  .blurb { font-style: italic; font-size: var(--fs-lead); color: var(--ink-mute); margin: 0 0 30px; line-height: 1.45; }
  .lead-reading { font-size: var(--fs-lead); line-height: 1.45; color: var(--ink); margin: 0 0 12px; font-variant-numeric: tabular-nums; }
  .plainline { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-caption); letter-spacing: .04em; color: var(--ink-soft); margin: 0 0 10px; }
  .plainline strong { color: var(--signal); font-weight: 600; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 34px 0 40px; }
  .cta { display: inline-block; padding: 11px 18px; font-size: var(--fs-micro); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--ink); color: var(--ink); background: transparent; transition: background .15s, color .15s, border-color .15s; }
  .cta:hover, .cta--primary { background: var(--ink); color: var(--paper); }
  .cta--primary:hover { background: var(--signal); border-color: var(--signal); }
  section { margin: 44px 0; }
  .answer p, .data p, .faq p { color: var(--ink-soft); font-size: var(--fs-body); margin: 0 0 15px; }
  .metrics dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; }
  .metrics div { background: var(--paper-tint); outline: 1px solid var(--hairline); padding: 15px 14px; min-width: 0; }
  dt { font-size: var(--fs-folio); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 6px; }
  dd { margin: 0; font-size: var(--fs-lead); line-height: 1.2; color: var(--ink); overflow-wrap: anywhere; }
  small { display: block; margin-top: 5px; font-size: var(--fs-folio); color: var(--ink-mute); letter-spacing: .04em; }
  .plate { margin: 44px 0; padding: 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--hairline); }
  .plate h2 { margin: 12px 0 6px; }
  .plate-scroll { overflow-x: auto; padding: 4px 0 10px; }
  svg.figure { display: block; width: 100%; min-width: 520px; height: auto; }
  .fx-rule { stroke: var(--hairline); stroke-width: 1; }
  .fx-axis { stroke: var(--hairline-strong); stroke-width: 1; }
  .fx-ref { stroke: var(--ink-faint); stroke-width: 1; stroke-dasharray: 3 3; }
  /* Element-qualified on purpose. The tone classes below set BOTH fill and
     stroke so one class can paint a line, a bar and a dot; a bare .fx-line
     loses to .fx-a on source order and every polyline on the site rendered as
     a filled polygon. Qualifying by element outranks a plain class. */
  path.fx-line { fill: none; stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; }
  path.fx-dash { stroke-dasharray: 5 3; }
  path.fx-faint { opacity: .5; stroke-width: 1; }
  path.fx-area { stroke: none; opacity: .12; }
  rect.fx-bar, rect.fx-cell, circle.fx-dot { stroke: none; }
  .fx-dot { opacity: .82; }
  .fx-a { stroke: var(--signal); fill: var(--signal); }
  .fx-b { stroke: var(--gold); fill: var(--gold); }
  .fx-c { stroke: var(--ink-mute); fill: var(--ink-mute); }
  .fx-d { stroke: var(--ink-soft); fill: var(--ink-soft); }
  .fx-e { stroke: var(--hairline-strong); fill: var(--hairline-strong); }
  .fx-up { stroke: var(--verdant); fill: var(--verdant); }
  .fx-dn { stroke: var(--oxblood); fill: var(--oxblood); }
  .fx-ink { stroke: var(--ink); fill: var(--ink); }
  .fx-band { fill: var(--paper-deep); stroke: none; }
  .fx-tick, .fx-note, .fx-rowlabel, .fx-value { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; }
  .fx-tick { font-size: 11px; fill: var(--ink-faint); }
  .fx-note { font-size: 10.5px; fill: var(--ink-mute); }
  .fx-rowlabel { font-size: 11px; fill: var(--ink-soft); }
  .fx-value { font-size: 11px; fill: var(--ink-mute); }
  .fx-incell { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-size: 9px; letter-spacing: .04em; fill: var(--paper); }
  .plate figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; padding: 10px 0 14px; font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-micro); color: var(--ink-mute); }
  .plate-no { font-size: var(--fs-folio); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-faint); }
  .plate-what { flex: 1 1 16em; min-width: 0; }
  .plate-src { color: var(--ink-faint); font-size: var(--fs-folio); letter-spacing: .04em; word-break: break-word; }
  details { border-top: 1px solid var(--hairline); padding: 14px 0; }
  details:last-child { border-bottom: 1px solid var(--hairline); }
  summary { cursor: pointer; font-weight: 700; }
  .link-raw { font-size: var(--fs-micro); word-break: break-word; }
  .conclusion { font-size: var(--fs-lead); line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .table-scroll { overflow: auto; max-height: 60vh; border: 1px solid var(--hairline); background: var(--paper-tint); }
  .table-scroll:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .datatable table { width: 100%; border-collapse: collapse; font-size: var(--fs-caption); font-variant-numeric: tabular-nums; }
  .datatable th, .datatable td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--hairline); white-space: nowrap; }
  .datatable td:first-child, .datatable th:first-child { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-micro); }
  .datatable thead th { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-folio); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute); background: var(--paper); position: sticky; top: 0; }
  .datatable tbody tr:nth-child(even) td { background: rgba(0,0,0,0.018); }
  .datatable tbody tr:last-child td { border-bottom: 0; }
  .table-note { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-variant-numeric: tabular-nums; font-size: var(--fs-folio); color: var(--ink-faint); margin-top: 10px; word-break: break-word; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 16px; padding: 10px 0; border-top: 1px solid var(--hairline); }
  .related li:last-child { border-bottom: 1px solid var(--hairline); }
  .related a { min-width: 0; overflow-wrap: break-word; }
  .related-kind { font-family: "HOM Figure", "Apparatus HOM", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; font-size: var(--fs-folio); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
  .colophon { margin-top: 72px; padding-top: 22px; border-top: 1px solid var(--hairline); font-size: var(--fs-micro); color: var(--ink-faint); letter-spacing: .08em; }
  @media (max-width: 680px) { main { padding: 20px 16px 72px; } .metrics dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cta { width: 100%; text-align: center; } }
